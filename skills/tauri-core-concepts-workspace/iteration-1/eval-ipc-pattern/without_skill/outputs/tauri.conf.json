{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "my-app",
    "version": "0.1.0"
  },
  "tauri": {
    "pattern": {
      "use": "isolation",
      "options": {
        "dir": "../dist-isolation"
      }
    },
    "allowlist": {
      "all": false,
      "fs": {
        "all": false,
        "readFile": true,
        "scope": ["$APPDATA/my-app/*.json"]
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["https://api.example.com/*"]
      }
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.example.com"
    }
  }
}

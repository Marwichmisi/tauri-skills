{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri: dev",
      "program": "${workspaceFolder}/src-tauri/target/debug/mon-app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug"
      },
      "cargo": {
        "args": ["build", "--manifest-path=${workspaceFolder}/src-tauri/Cargo.toml", "--no-default-features"]
      },
      "preLaunchTask": "ui:dev",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri: prod",
      "program": "${workspaceFolder}/src-tauri/target/release/mon-app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=${workspaceFolder}/src-tauri/Cargo.toml",
          "--no-default-features"
        ]
      },
      "preLaunchTask": "ui:build",
      "sourceLanguages": ["rust"]
    }
  ]
}

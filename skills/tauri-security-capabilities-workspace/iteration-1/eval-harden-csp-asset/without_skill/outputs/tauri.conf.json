{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harden-csp-asset-app",
  "version": "0.1.0",
  "identifier": "com.example.harden-csp-asset",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "harden-csp-asset-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: https://asset.localhost; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/**"],
          "deny": ["$APPCACHE/**/secrets/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

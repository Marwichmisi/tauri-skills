{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "my-app",
  "version": "0.1.0",
  "mainBinaryName": "my-app",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/*"]
        }
      }
    },
    "trayIcon": {}
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "active": true
    },
    "cli": {}
  }
}
